; Z80-MBC2 ROM build of the monitor from the single source monitor.z80
;
; Pre-defines the target selection (MBC2 instead of the CP/M default)
; and INCLUDEs the real source. Built with:  zx80asm monmbc2/hfs
;
; The output monmbc2.hex is absolute code for loading at address 0
; (see ORG in monitor.z80) and is the image for the Z80-MBC2 ROM.
;
CPM		equ	0
MBC2		equ	not CPM
	INCLUDE	monitor.z80
